{:deps  {aero/aero            {:mvn/version "1.1.6"}
         integrant/integrant  {:mvn/version "0.13.0"}
         metosin/malli        {:mvn/version "0.16.4"}
         reagent/reagent      {:mvn/version "1.2.0"}
         babashka/fs          {:mvn/version "0.5.34"}
         babashka/process     {:mvn/version "0.5.22"}
         hiccup/hiccup        {:mvn/version "2.0.0"}
         org.clojure/clojure  {:mvn/version "1.12.0"}
         org.clojure/data.xml {:mvn/version "0.2.0-alpha11"}
         tick/tick            {:mvn/version "0.7.5"}
         ring/ring-core       {:mvn/version "1.12.2"}
         ring/ring-jetty-adapter {:mvn/version "1.12.2"}}
 :paths ["src" "resources"]
 :aliases
 {:dev  {:extra-deps  {nrepl/nrepl          {:mvn/version "1.3.0"}
                       cider/cider-nrepl    {:mvn/version "0.50.2"}
                       thheller/shadow-cljs {:mvn/version "2.28.18"}}
         :extra-paths ["dev"]
         :main-opts   ["-m" "nrepl.cmdline"
                       "--middleware"
                       "[cider.nrepl/cider-middleware]"]}
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.18"}}}}}
